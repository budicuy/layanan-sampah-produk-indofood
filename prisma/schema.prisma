generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication Models ─────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  username  String     @unique
  role      Role       @default(KONSUMEN)
  status    StatusUser @default(AKTIF)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  accounts Account[]
  nasabah  Nasabah?

  @@map("user")
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  KONSUMEN
  ADMIN
  HRD
  BANK_SAMPAH
}

enum StatusUser {
  AKTIF
  NONAKTIF
}

enum KategoriNasabah {
  BANK_SAMPAH
  WARMIENDO
  PERORANGAN
}

enum StatusNasabah {
  AKTIF
  NONAKTIF
}

enum JenisSetor {
  LANGSUNG
  EKSPEDISI
}

enum JenisSampah {
  PLASTIK
  KARTON
  PAPER_CUP
}



/// Status alur setor sampah:
/// MENUNGGU_VERIFIKASI → Konsumen baru submit
/// TERVERIFIKASI       → Admin konfirmasi data valid
/// DITOLAK             → Admin tolak (data tidak valid)
/// DALAM_PENJEMPUTAN   → Ekpedisi ditugaskan, sedang menuju konsumen
/// SUDAH_DISERAHKAN    → Konsumen konfirmasi sudah menyerahkan ke kurir
/// SAMPAH_DITERIMA     → Admin konfirmasi sampah sudah tiba di pusat
/// SELESAI             → Saldo sudah dikreditkan ke nasabah
enum StatusSetorSampah {
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
  DALAM_PENJEMPUTAN
  SUDAH_DISERAHKAN
  SAMPAH_DITERIMA
  SELESAI
}

// ─── Business models ─────────────────────────────────────────────────────────

model Nasabah {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  alamat      String
  noTelp      String
  kategori    KategoriNasabah
  nik         String          @unique
  noRek       String
  jenisBank   String
  titikLokasi String?
  status      StatusNasabah   @default(AKTIF)
  poin        Int             @default(0)
  saldo       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  setorSampah SetorSampah[]
  mutasiSaldo MutasiSaldo[]
  kupons      Kupon[]
  pencairan   Pencairan[]

  @@map("nasabah")
}

/// Data kurir / ekspedisi penjemputan
model Ekpedisi {
  id        String   @id @default(cuid())
  nama      String
  noTelp    String
  alamat    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setorSampah SetorSampah[]

  @@map("ekpedisi")
}

/// Referensi harga sampah per bulan
model HargaSampah {
  id          String      @id @default(cuid())
  harga       Int
  point       Int         @default(0)
  bulan       DateTime
  jenisSampah JenisSampah
  berat       Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("harga_sampah")
}

// ─── Fitur Setor Sampah ───────────────────────────────────────────────────────

model SetorSampah {
  id                String      @id @default(cuid())
  nasabahId         String
  nasabah           Nasabah     @relation(fields: [nasabahId], references: [id])
  jenisSampah       JenisSampah
  beratEstimasi     Float // Estimasi berat (kg) diisi konsumen
  beratAktual       Float? // Berat aktual setelah ditimbang
  keterangan        String? // Catatan dari konsumen
  alamatPenjemputan String
  jenisSetor        JenisSetor @default(EKSPEDISI)

  status StatusSetorSampah @default(MENUNGGU_VERIFIKASI)

  // Verifikasi awal
  catatanAdmin String?
  verifiedBy   String?  // Nama admin yang memverifikasi
  verifikasiAt DateTime?

  // Penjemputan
  ekpedisiId    String?
  ekpedisi      Ekpedisi? @relation(fields: [ekpedisiId], references: [id])
  penjemputanAt DateTime?

  // Serah terima konsumen → kurir
  diserahkanAt DateTime?

  // Verifikasi akhir & pencairan
  poinPerKg  Int? // Point per kg yang diberikan
  totalPoin  Int? // Total poin dikreditkan ke nasabah
  hargaPerKg Int? // Rupiah per kg yang diberikan
  totalHarga Int? // Total Rupiah dikreditkan ke nasabah
  selesaiAt  DateTime?

  // AI Validation and images
  gambarTimbangan   String?
  gambarBukti       String[]    @default([])
  statusValidasi    String?     // "VALID", "INVALID", "PERLU_REVIEW", "MANUAL"
  beratTerbaca      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nasabahId, status])
  @@index([status])
  @@index([selesaiAt])
  @@map("setor_sampah")
}

/// Riwayat mutasi saldo nasabah
model MutasiSaldo {
  id          String   @id @default(cuid())
  nasabahId   String
  nasabah     Nasabah  @relation(fields: [nasabahId], references: [id])
  jumlah      Int // Positif = kredit, negatif = debit
  keterangan  String
  referensiId String? // ID SetorSampah atau transaksi lain
  createdAt   DateTime @default(now())

  @@index([nasabahId])
  @@map("mutasi_saldo")
}

model Kupon {
  id          String      @id @default(cuid())
  kode        String      @unique // Kode acak kupon untuk QR code
  nama        String      // Nama reward, e.g. "Kupon Sembako Rp 10.000"
  deskripsi   String?
  poinCost    Int         // Biaya poin
  status      KuponStatus @default(AKTIF)
  nasabahId   String
  nasabah     Nasabah     @relation(fields: [nasabahId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  digunakanAt DateTime?

  @@index([nasabahId])
  @@map("kupon")
}

enum KuponStatus {
  AKTIF
  DIGUNAKAN
  EXPIRED
}

model TierKupon {
  id        String   @id @default(cuid())
  tier      String   @unique // "DIAMOND", "GOLD", "PLATINUM"
  poinMin   Int
  nama      String   // E.g. "Diamond", "Gold", "Platinum"
  deskripsi String   // E.g. "Dapat ditukarkan dengan..."
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tier_kupon")
}

model RawMaterial {
  id          String   @id @default(cuid())
  periode     DateTime // Bulan dan tahun data dimasukkan (representasi tanggal awal bulan)
  kategori    String   // "Etiket", "Karton", "Cup"
  klasifikasi String   // "NN", "CN", "GN"
  beratGr     Float    // Berat dalam satuan Gram
  beratKg     Float    // Berat dalam satuan Kilogram (konversi beratGr / 1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([periode, kategori, klasifikasi])
  @@map("raw_material")
}

/// Pencairan dana untuk nasabah Bank Sampah
model Pencairan {
  id         String          @id @default(cuid())
  nasabahId  String
  nasabah    Nasabah         @relation(fields: [nasabahId], references: [id])
  jumlah     Int             // Nominal pencairan (kelipatan 50rb, min 50rb)
  status     StatusPencairan @default(DIAJUKAN)
  catatan    String?         // Catatan dari bank sampah saat pengajuan
  catatanAdmin String?       // Catatan verifikasi dari admin
  buktiFoto  String?         // URL foto bukti pencairan di Cloudflare R2
  diajukanAt DateTime        @default(now())
  diverifikasi DateTime?
  dicairkan  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([nasabahId, status])
  @@index([status])
  @@map("pencairan")
}

enum StatusPencairan {
  DIAJUKAN
  DIVERIFIKASI
  DICAIRKAN
  DITOLAK
}

