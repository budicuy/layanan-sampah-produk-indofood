generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication Models ─────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  username  String     @unique
  role      Role       @default(KONSUMEN)
  status    StatusUser @default(AKTIF)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  accounts Account[]
  nasabah  Nasabah?

  @@map("user")
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  KONSUMEN
  ADMIN
  HRD
  BANK_SAMPAH
}

enum StatusUser {
  AKTIF
  NONAKTIF
}

enum KategoriNasabah {
  BANK_SAMPAH
  WARMIENDO
  PERORANGAN
}

enum StatusNasabah {
  AKTIF
  NONAKTIF
}

enum JenisSampah {
  PLASTIK
  KARTON
  PAPER_CUP
}

/// Status alur setor langsung (drop-off):
/// MENUNGGU_VERIFIKASI → Konsumen baru submit
/// DITOLAK             → Admin tolak
/// SELESAI             → Admin verifikasi & kredit poin
enum StatusSetorLangsung {
  MENUNGGU_VERIFIKASI
  DITOLAK
  SELESAI
}

/// Status alur setor ekspedisi (kurir penjemput):
/// MENUNGGU_VERIFIKASI → Konsumen submit pickup request
/// TERVERIFIKASI       → Admin konfirmasi data valid
/// DITOLAK             → Admin tolak
/// DALAM_PENJEMPUTAN   → Kurir ditugaskan, menuju konsumen
/// SUDAH_DISERAHKAN    → Konsumen konfirmasi sudah menyerahkan ke kurir
/// SAMPAH_DITERIMA     → Admin konfirmasi sampah tiba di pusat
/// SELESAI             → Poin dikreditkan ke nasabah
enum StatusSetorEkspedisi {
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
  DALAM_PENJEMPUTAN
  SUDAH_DISERAHKAN
  SAMPAH_DITERIMA
  SELESAI
}

// ─── Business models ─────────────────────────────────────────────────────────

model Nasabah {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  alamat      String
  noTelp      String
  kategori    KategoriNasabah
  nik         String          @unique
  noRek       String
  jenisBank   String
  titikLokasi String?
  status      StatusNasabah   @default(AKTIF)
  poin        Int             @default(0)
  saldo       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  setorLangsung  SetorLangsung[]
  setorEkspedisi SetorEkspedisi[]
  mutasiSaldo    MutasiSaldo[]
  kupons         Kupon[]
  pencairan      Pencairan[]

  @@map("nasabah")
}

/// Data kurir / ekspedisi penjemputan
model Ekpedisi {
  id        String   @id @default(cuid())
  nama      String
  noTelp    String
  alamat    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setorEkspedisi SetorEkspedisi[]

  @@map("ekpedisi")
}

/// Referensi harga sampah per bulan
model HargaSampah {
  id          String      @id @default(cuid())
  harga       Int
  point       Int         @default(0)
  bulan       DateTime
  jenisSampah JenisSampah
  berat       Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("harga_sampah")
}

// ─── Fitur Setor Sampah ───────────────────────────────────────────────────────

/// Setoran sampah langsung (drop-off di pusat). Alur: MENUNGGU → DITOLAK/SELESAI
model SetorLangsung {
  id            String              @id @default(cuid())
  nasabahId     String
  nasabah       Nasabah             @relation(fields: [nasabahId], references: [id])
  jenisSampah   JenisSampah
  beratEstimasi Float               // Estimasi berat (kg) diisi konsumen
  beratAktual   Float?              // Berat aktual setelah ditimbang admin
  keterangan    String?             // Catatan dari konsumen

  status StatusSetorLangsung @default(MENUNGGU_VERIFIKASI)

  // Verifikasi & pencairan (dilakukan sekaligus oleh admin)
  catatanAdmin String?
  verifiedBy   String?   // Label verifikasi: "Sistem (AI)", "Manual oleh X", dll.
  verifikasiAt DateTime?
  selesaiAt    DateTime?

  // Reward
  poinPerKg  Int? // Poin per kg
  totalPoin  Int? // Total poin dikreditkan
  hargaPerKg Int? // Rupiah per kg (khusus Bank Sampah)
  totalHarga Int? // Total rupiah (khusus Bank Sampah)

  // AI Validation & images
  gambarTimbangan String?
  gambarBukti     String[] @default([])
  statusValidasi  String?  // "VALID", "INVALID", "PERLU_REVIEW", "MANUAL"
  beratTerbaca    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nasabahId, status])
  @@index([status])
  @@index([selesaiAt])
  @@map("setor_langsung")
}

/// Setoran sampah via kurir ekspedisi. Alur: MENUNGGU → TERVERIFIKASI → DALAM_PENJEMPUTAN → SUDAH_DISERAHKAN → SAMPAH_DITERIMA → SELESAI
model SetorEkspedisi {
  id            String               @id @default(cuid())
  nasabahId     String
  nasabah       Nasabah              @relation(fields: [nasabahId], references: [id])
  jenisSampah   JenisSampah
  beratEstimasi Float                // Estimasi berat (kg) diisi konsumen
  beratAktual   Float?               // Berat aktual setelah ditimbang admin
  keterangan    String?              // Catatan dari konsumen
  alamatPenjemputan String           // Alamat penjemputan oleh kurir

  status StatusSetorEkspedisi @default(MENUNGGU_VERIFIKASI)

  // Verifikasi awal
  catatanAdmin String?
  verifiedBy   String?   // Label verifikasi
  verifikasiAt DateTime?

  // Penjemputan
  ekpedisiId    String?
  ekpedisi      Ekpedisi? @relation(fields: [ekpedisiId], references: [id])
  penjemputanAt DateTime?

  // Serah terima konsumen → kurir
  diserahkanAt DateTime?

  // Penerimaan di pusat & pencairan
  sampahDiterimaAt DateTime?
  selesaiAt        DateTime?

  // Reward
  poinPerKg  Int?
  totalPoin  Int?
  hargaPerKg Int? // Khusus Bank Sampah
  totalHarga Int? // Khusus Bank Sampah

  // AI Validation & images
  gambarTimbangan String?
  gambarBukti     String[] @default([])
  statusValidasi  String?  // "VALID", "INVALID", "PERLU_REVIEW", "MANUAL"
  beratTerbaca    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nasabahId, status])
  @@index([status])
  @@index([selesaiAt])
  @@map("setor_ekspedisi")
}

/// Riwayat mutasi saldo/poin nasabah
model MutasiSaldo {
  id              String   @id @default(cuid())
  nasabahId       String
  nasabah         Nasabah  @relation(fields: [nasabahId], references: [id])
  jumlah          Int      // Positif = kredit, negatif = debit
  keterangan      String
  referensiId     String?  // ID SetorLangsung atau SetorEkspedisi
  jenisReferensi  String?  // "LANGSUNG" atau "EKSPEDISI"
  createdAt       DateTime @default(now())

  @@index([nasabahId])
  @@map("mutasi_saldo")
}

model Kupon {
  id          String      @id @default(cuid())
  kode        String      @unique // Kode acak kupon untuk QR code
  nama        String      // Nama reward, e.g. "Kupon Sembako Rp 10.000"
  deskripsi   String?
  poinCost    Int         // Biaya poin
  status      KuponStatus @default(AKTIF)
  nasabahId   String
  nasabah     Nasabah     @relation(fields: [nasabahId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  digunakanAt DateTime?

  @@index([nasabahId])
  @@map("kupon")
}

enum KuponStatus {
  AKTIF
  DIGUNAKAN
  EXPIRED
}

model TierKupon {
  id        String   @id @default(cuid())
  tier      String   @unique // "DIAMOND", "GOLD", "PLATINUM"
  poinMin   Int
  nama      String   // E.g. "Diamond", "Gold", "Platinum"
  deskripsi String   // E.g. "Dapat ditukarkan dengan..."
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tier_kupon")
}

model RawMaterial {
  id          String   @id @default(cuid())
  periode     DateTime // Bulan dan tahun data dimasukkan (representasi tanggal awal bulan)
  kategori    String   // "Etiket", "Karton", "Cup"
  klasifikasi String   // "NN", "CN", "GN"
  beratGr     Float    // Berat dalam satuan Gram
  beratKg     Float    // Berat dalam satuan Kilogram (konversi beratGr / 1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([periode, kategori, klasifikasi])
  @@map("raw_material")
}

/// Pencairan dana untuk nasabah Bank Sampah
model Pencairan {
  id           String          @id @default(cuid())
  nasabahId    String
  nasabah      Nasabah         @relation(fields: [nasabahId], references: [id])
  jumlah       Int             // Nominal pencairan (kelipatan 50rb, min 50rb)
  status       StatusPencairan @default(DIAJUKAN)
  catatan      String?         // Catatan dari bank sampah saat pengajuan
  catatanAdmin String?         // Catatan verifikasi dari admin
  buktiFoto    String?         // URL foto bukti pencairan di Cloudflare R2
  diajukanAt   DateTime        @default(now())
  diverifikasi DateTime?
  dicairkan    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([nasabahId, status])
  @@index([status])
  @@map("pencairan")
}

enum StatusPencairan {
  DIAJUKAN
  DIVERIFIKASI
  DICAIRKAN
  DITOLAK
}
