generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth tables (managed by Better Auth) ────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  username      String     @unique
  role          Role       @default(KONSUMEN)
  status        StatusUser @default(AKTIF)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions Session[]
  accounts Account[]
  nasabah  Nasabah?
  ekpedisi Ekpedisi?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id
  accountId    String
  providerId   String
  userId       String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  KONSUMEN
  ADMIN
  HRD
}

enum StatusUser {
  AKTIF
  NONAKTIF
}

enum KategoriNasabah {
  BANK_SAMPAH
  WARMIENDO
  PERORANGAN
}

enum StatusNasabah {
  AKTIF
  NONAKTIF
}

enum JenisProduk {
  PLASTIK
  KARTON
}

enum StatusEkpedisi {
  BELUM_DI_PROSES
  PROSES
  DONE
}

enum JenisSampah {
  PLASTIK
  KARTON
}

/// Status alur setor sampah:
/// MENUNGGU_VERIFIKASI → Konsumen baru submit
/// TERVERIFIKASI       → Admin konfirmasi data valid
/// DITOLAK             → Admin tolak (data tidak valid)
/// DALAM_PENJEMPUTAN   → Ekpedisi ditugaskan, sedang menuju konsumen
/// SUDAH_DISERAHKAN    → Konsumen konfirmasi sudah menyerahkan ke kurir
/// SAMPAH_DITERIMA     → Admin konfirmasi sampah sudah tiba di pusat
/// SELESAI             → Saldo sudah dikreditkan ke nasabah
enum StatusSetorSampah {
  MENUNGGU_VERIFIKASI
  TERVERIFIKASI
  DITOLAK
  DALAM_PENJEMPUTAN
  SUDAH_DISERAHKAN
  SAMPAH_DITERIMA
  SELESAI
}

// ─── Business models ─────────────────────────────────────────────────────────

model Nasabah {
  id          String          @id @default(cuid())
  userId      String?         @unique // Relasi opsional ke User (konsumen)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  nama        String
  alamat      String
  noTelp      String
  kategori    KategoriNasabah
  nik         String          @unique
  noRek       String
  jenisBank   String
  fotoLokasi  String?
  titikLokasi String?
  status      StatusNasabah   @default(AKTIF)
  saldo       Int             @default(0) // Saldo tabungan dalam rupiah
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  setorSampah SetorSampah[]
  mutasiSaldo MutasiSaldo[]

  @@map("nasabah")
}

/// Master data produk kemasan Indofood
model Produk {
  id        String      @id @default(cuid())
  kode      String      @unique
  nama      String
  jenis     JenisProduk
  berat     Float
  brand     String
  harga     Int
  isi       Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("produk")
}

/// Data kurir / ekspedisi penjemputan
model Ekpedisi {
  id          String         @id @default(cuid())
  userId      String?        @unique
  noTelp      String
  alamat      String
  titikLokasi String?
  status      StatusEkpedisi @default(BELUM_DI_PROSES)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  setorSampah SetorSampah[]

  @@map("ekpedisi")
}

/// Referensi harga sampah per bulan
model HargaSampah {
  id          String      @id @default(cuid())
  harga       Int
  bulan       DateTime
  jenisSampah JenisSampah
  berat       Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("harga_sampah")
}

// ─── Fitur Setor Sampah ───────────────────────────────────────────────────────

model SetorSampah {
  id                String            @id @default(cuid())
  nasabahId         String
  nasabah           Nasabah           @relation(fields: [nasabahId], references: [id])
  jenisSampah       JenisSampah
  beratEstimasi     Float // Estimasi berat (kg) diisi konsumen
  beratAktual       Float? // Berat aktual setelah ditimbang
  keterangan        String? // Catatan dari konsumen
  alamatPenjemputan String

  status StatusSetorSampah @default(MENUNGGU_VERIFIKASI)

  // Verifikasi awal
  catatanAdmin String?
  verifikasiAt DateTime?

  // Penjemputan
  ekpedisiId    String?
  ekpedisi      Ekpedisi?  @relation(fields: [ekpedisiId], references: [id])
  penjemputanAt DateTime?

  // Serah terima konsumen → kurir
  diserahkanAt DateTime?

  // Verifikasi akhir & pencairan
  hargaPerKg Int? // Rp per kg
  totalSaldo Int? // Total dikreditkan ke nasabah
  selesaiAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nasabahId])
  @@index([status])
  @@index([selesaiAt])
  @@map("setor_sampah")
}

/// Riwayat mutasi saldo nasabah
model MutasiSaldo {
  id          String   @id @default(cuid())
  nasabahId   String
  nasabah     Nasabah  @relation(fields: [nasabahId], references: [id])
  jumlah      Int // Positif = kredit, negatif = debit
  keterangan  String
  referensiId String? // ID SetorSampah atau transaksi lain
  createdAt   DateTime @default(now())

  @@index([nasabahId])
  @@map("mutasi_saldo")
}
